# Shared
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_SCHEMA=public
SUPABASE_TABLE=items
SUPABASE_SELECT=*
SUPABASE_PAGE_SIZE=1000
SUPABASE_ORDER_FIELD=id
SUPABASE_FILTERS_JSON=[]

# Notion sync
NOTION_TOKEN=secret_replace_me
NOTION_DATABASE_ID=replace-me
NOTION_SOURCE_ID_FIELD=id
NOTION_SOURCE_ID_PROPERTY=Source ID
NOTION_SYNC_HASH_PROPERTY=Sync Hash
NOTION_FIELD_MAP_JSON={"Name":{"source":"name","type":"title"},"Status":{"source":"status","type":"rich_text"},"Updated At":{"source":"updated_at","type":"date"}}
NOTION_TITLE_FALLBACK=Untitled

# Drive backup
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-me\\n-----END PRIVATE KEY-----\\n"
GOOGLE_DRIVE_FOLDER_ID=replace-me
BACKUP_OUTPUT_DIR=artifacts/backups
BACKUP_FILE_PREFIX=supabase-export

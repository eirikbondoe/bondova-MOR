# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Notion Configuration
NOTION_TOKEN=your-notion-integration-token

# Table Mappings (add as many as needed)
# Format: SUPABASE_TABLE_<NAME>=table_name
# Format: NOTION_DATABASE_<NAME>=database_id
SUPABASE_TABLE_EXAMPLE=example_table
NOTION_DATABASE_EXAMPLE=your-notion-database-id

# Optional: Logging level (debug, info, warn, error)
LOG_LEVEL=info

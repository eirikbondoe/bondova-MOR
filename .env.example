# bondova-MOR Environment Configuration
# Copy this file to .env.local and fill in actual values

# Environment
NODE_ENV=development

# Database Configuration
# DATABASE_URL=******localhost:5432/bondova_mor

# Skape Integration
# SKAPE_API_KEY=your_skape_api_key_here
# SKAPE_API_URL=https://skape.api.example.com

# Motor Configuration
# MOTOR_BATCH_SIZE=100
# MOTOR_TIMEOUT_MS=30000

# Logging
# LOG_LEVEL=debug
